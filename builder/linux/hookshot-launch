#!/bin/sh
# Start the game Hookshot Builder wrote, from that folder, without the AppImage's libraries.
# The builder AppImage calls this for --play. The window's Play button does the same thing.
#
#   hookshot-launch                      the out= folder in ~/.config/hookshot/builder.ini
#   hookshot-launch /path/to/the/game    that folder
#   HOOKSHOT_LAUNCH_CONFIG=<file>        read that ini instead (a test)
set -eu

ini_path() {
    if [ -n "${HOOKSHOT_LAUNCH_CONFIG:-}" ]; then
        printf '%s\n' "$HOOKSHOT_LAUNCH_CONFIG"
    elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
        printf '%s\n' "$XDG_CONFIG_HOME/hookshot/builder.ini"
    elif [ -n "${HOME:-}" ]; then
        printf '%s\n' "$HOME/.config/hookshot/builder.ini"
    fi   # (neither: no ini, rather than one under /.config)
}

# the last <name>= line, as the builder keeps the last value it wrote
value_of() {
    value=
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            "$2"=*) value=${line#"$2"=} ;;
        esac
    done < "$1"
    [ -n "$value" ] || return 1
    printf '%s\n' "$value"
}

ready() {
    [ -n "${1:-}" ] && [ -f "$1/image.bin" ] && { [ -x "$1/bin/hookshot" ] || [ -f "$1/hookshot" ]; }
}

folder=${1:-}
ini=$(ini_path)
profile=
gamescope=
if [ -f "$ini" ]; then
    if [ -z "$folder" ]; then
        folder=$(value_of "$ini" out) || folder=
    fi
    # (the profile the launcher's Play chose last: nx2/profiles.py. The game itself plays the default profile
    # instead when it is not on the list in its user folder: host/nn_applet.c)
    profile=$(value_of "$ini" profile) || profile=
    # (the Flutter builder's Play option: start the game inside gamescope unless already there)
    gamescope=$(value_of "$ini" gamescope) || gamescope=
    gamescope_width=$(value_of "$ini" gamescope_width) || gamescope_width=
    gamescope_height=$(value_of "$ini" gamescope_height) || gamescope_height=
    gamescope_refresh=$(value_of "$ini" gamescope_refresh) || gamescope_refresh=
    gamescope_fullscreen=$(value_of "$ini" gamescope_fullscreen) || gamescope_fullscreen=
    gamescope_hdr=$(value_of "$ini" gamescope_hdr) || gamescope_hdr=
    gamescope_grab=$(value_of "$ini" gamescope_grab_cursor) || gamescope_grab=
    gamescope_rt=$(value_of "$ini" gamescope_rt) || gamescope_rt=
    gamescope_gamemoderun=$(value_of "$ini" gamescope_gamemoderun) || gamescope_gamemoderun=
    gamescope_extra=$(value_of "$ini" gamescope_extra) || gamescope_extra=
fi
want_gamescope=${HOOKSHOT_GAMESCOPE:-${gamescope:-0}}

if ! ready "$folder"; then
    echo "Hookshot: no built game to start. Build one with Hookshot Builder, or pass its folder." >&2
    # (HOOKSHOT_LAUNCH_CONFIG is a test: it must not open a dialog)
    if [ -z "${HOOKSHOT_LAUNCH_CONFIG:-}" ]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --error --title=Hookshot --text="No built game to start. Build one with Hookshot Builder first." || true
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --error "No built game to start. Build one with Hookshot Builder first." || true
        fi
    fi
    exit 1
fi

# The AppImage runtime and the builder put their own libraries on the search path. The game loads
# SDL from beside itself, so those names go before it starts. Same set as the builder's Play button.
names=$(env | awk -F= '$1 ~ /^(HOOKSHOT_|PYTHON|APPDIR|APPIMAGE|ARGV0|OWD)/ || $1 == "LD_LIBRARY_PATH" { print $1 }')
for name in $names; do
    unset "$name"
done

cd "$folder"
# (--play already chose Play: a game built when it asked about updates itself does not ask again)
export HOOKSHOT_NO_UPDATE_CHECK=1
if [ -n "$profile" ]; then
    export HOOKSHOT_PROFILE="$profile"
fi
inside_gamescope=0
case ${XDG_CURRENT_DESKTOP:-} in
    *[Gg][Aa][Mm][Ee][Ss][Cc][Oo][Pp][Ee]*) inside_gamescope=1 ;;
esac
if [ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ]; then
    inside_gamescope=1
fi
if [ "$want_gamescope" != 0 ] && [ "$inside_gamescope" = 0 ] && command -v gamescope >/dev/null 2>&1; then
    if [ -x ./bin/hookshot ]; then
        target=./bin/hookshot
    else
        target=./hookshot
    fi
    set -- -- "$target"
    [ -n "$gamescope_extra" ] && set -- $gamescope_extra "$@"
    [ "$gamescope_rt" = 1 ] && set -- --rt "$@"
    [ "$gamescope_grab" = 1 ] && set -- --force-grab-cursor "$@"
    [ "$gamescope_hdr" = 1 ] && set -- --hdr-enabled "$@"
    [ "$gamescope_fullscreen" = 1 ] && set -- -f "$@"
    [ -n "$gamescope_refresh" ] && set -- -r "$gamescope_refresh" "$@"
    [ -n "$gamescope_height" ] && set -- -H "$gamescope_height" "$@"
    [ -n "$gamescope_width" ] && set -- -W "$gamescope_width" "$@"
    if [ "$gamescope_gamemoderun" = 1 ] && command -v gamemoderun >/dev/null 2>&1; then
        exec gamemoderun gamescope "$@"
    fi
    exec gamescope "$@"
fi
if [ -x ./bin/hookshot ]; then
    exec ./bin/hookshot
fi
exec ./hookshot
