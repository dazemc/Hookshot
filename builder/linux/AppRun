#!/bin/sh
# The Hookshot AppImage: the Flutter builder window with the Rust engine, the
# a64emit translator and the sources a game is built from. No Python runtime
# is carried: the engine builds the game itself.
#
#   Hookshot.AppImage                  the builder window
#   Hookshot.AppImage --play           start the game the builder saved
#   Hookshot.AppImage --play <folder>  start the game in that folder
#   Hookshot.AppImage --launch <dir>   the game folder's launcher (Play, and Update when newer)
#   Hookshot.AppImage <folder>         the same
#
# The options are the Flutter window's own (builder/flutter/lib/main.dart):
# AppRun only points it at the tools the image carries.
HERE="$(dirname "$(readlink -f "$0")")"
TOOLS="$HERE/usr/share/hookshot"
APP="$HERE/usr/lib/hookshot/flutter/hookshot_builder"
export HOOKSHOT_TOOLS="$TOOLS"
# (found beside the app already; named here too so a moved bundle still loads them)
export HOOKSHOT_ENGINE_CLI="$HERE/usr/lib/hookshot/flutter/lib/hookshot_engine"
export HOOKSHOT_A64EMIT_LIB="$HERE/usr/lib/hookshot/flutter/lib/liba64emit.so"
# (written into the game folder's hookshot_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export HOOKSHOT_BUILDER_EXE="$APPIMAGE"
else
    export HOOKSHOT_BUILDER_EXE="$HERE/AppRun"
fi
if [ ! -x "$APP" ]; then
    echo "Hookshot Builder: $APP is missing from this image" >&2
    exit 1
fi
exec "$APP" "$@"
